{
  "name": "dsh-account-balance-pill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: shows the DeepSeek account's remaining balance in the composer bottom bar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azkbzxf/dsh-account-balance-pill.git"
  },
  "homepage": "https://github.com/azkbzxf/dsh-account-balance-pill#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "account",
    "balance"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
